<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- <clear /> makes restore reproducible: only the feeds listed here are used,
       regardless of machine-level NuGet.config files. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
